---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Home from '../components/Home.astro';

const title = 'drivectl | Google Drive, Docs & Sheets CLI + MCP Server';
const description =
  'A Go CLI and Model Context Protocol (MCP) server for Google Drive, Google Docs, and Google Sheets, powered by ergonomic native subcommands and live Google API Discovery.';
---

<Base title={title} description={description}>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "drivectl",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS, Linux",
      "url": "https://github.com/ghchinoy/drivectl"
    }
  </script>
  <Nav />
  <main id="main">
    <Home />
  </main>
  <Footer />
</Base>
