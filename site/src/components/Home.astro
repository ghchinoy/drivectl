---
import Button from './gb/Button.astro';
import Mark from './Mark.astro';
import Symbol from './gb/Symbol.astro';

const repo = 'https://github.com/ghchinoy/drivectl';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const highlights = [
  {
    question: 'Markdown ↔ Google Docs AST',
    detail: 'Convert local Markdown into rich Docs elements or export Docs back to clean Markdown.',
  },
  {
    question: 'Dynamic Discovery routing',
    detail: 'drivectl call inspects live Google Discovery schemas to route path, query, and body fields.',
  },
  {
    question: 'Deterministic agent JSON & MCP',
    detail: 'Pass -O json to any command or run drivectl --mcp over stdio or Streamable HTTP.',
  },
];

const startingPoints = [
  {
    title: 'Manage Drive, Docs & Sheets',
    text: 'List files, convert Markdown to Docs, and query or update Sheets ranges.',
    href: `${base}/getting-started`,
  },
  {
    title: 'Call any Workspace API',
    text: 'Invoke arbitrary Google REST endpoints dynamically via Google API Discovery.',
    href: `${base}/commands/discovery`,
  },
  {
    title: 'Connect an AI agent via MCP',
    text: 'Run drivectl as an MCP server or install the bundled google-drive-cli Agent Skill.',
    href: `${base}/commands/mcp`,
  },
];

const installMethods = [
  {
    name: 'Prebuilt binary',
    step: 'Download and verify the latest release binary into your current directory.',
    copy: 'curl -sL https://raw.githubusercontent.com/ghchinoy/drivectl/main/skills/google-drive-cli/scripts/install.sh | bash',
  },
  {
    name: 'Go install',
    step: 'Install directly with Go 1.26 or later.',
    copy: 'go install github.com/ghchinoy/drivectl@latest',
  },
  {
    name: 'Agent Skill',
    step: 'Install the google-drive-cli Agent Skill into your project.',
    copy: 'npx skills add ghchinoy/drivectl --skill google-drive-cli',
  },
  {
    name: 'MCP server',
    step: 'Launch drivectl as a Model Context Protocol server over stdio.',
    copy: 'drivectl --mcp',
  },
  {
    name: 'From source',
    step: 'Clone the repository and build the binary locally.',
    copy: `git clone ${repo}.git && \\\ncd drivectl && \\\ngo build -o drivectl .`,
  },
];
---

<section class="wrap hero">
  <div class="introduction">
    <h1>drivectl</h1>
    <p class="lead">
      A Go CLI and Model Context Protocol (MCP) server for Google Drive, Google Docs, and Google Sheets. Combine ergonomic native subcommands with dynamic Google API Discovery for interactive shells and AI coding agents.
    </p>
    <div class="actions">
      <Button color="outlined" size="md" href={`${base}/install`}>Install</Button>
      <a href={`${base}/getting-started`}>Get started</a>
    </div>
  </div>
  <figure class="handoff">
    <ol>
      <li>
        <Mark variant="workspace" size={40} />
        <div>
          <h2>Ergonomic native commands</h2>
          <p>Stream Drive uploads, convert Markdown to Docs AST, and read or write Sheets A1 ranges.</p>
        </div>
      </li>
      <li class="minor">
        <span class="node"></span>
        <div>
          <h2>Dynamic API Discovery</h2>
          <p>Invoke any Google REST endpoint with <code>drivectl call</code> and a JSON payload.</p>
        </div>
      </li>
      <li>
        <Mark variant="agent" size={40} />
        <div>
          <h2>Agent-ready JSON &amp; MCP</h2>
          <p>Emit deterministic <code>-O json</code> output or expose Workspace tools over stdio and HTTP MCP.</p>
        </div>
      </li>
      <li class="minor">
        <span class="node"></span>
        <div>
          <h2>Composable recipes</h2>
          <p>Automate multi-step Workspace workflows with declarative JSON recipes.</p>
        </div>
      </li>
    </ol>
  </figure>
</section>

<section class="wrap example">
  <div class="explanation">
    <h2>Built for humans and agents</h2>
    <p>
      Use native subcommands for complex media and AST conversions, and fall back to live Google Discovery schemas whenever you need an arbitrary REST method.
    </p>
  </div>
  <figure class="sheet">
    <h3>Terminal &amp; agent workflow</h3>
    <p>
      Convert a local Markdown specification into a formatted Doc with <span class="gap">drivectl docs create</span><sup>1</sup>, grant permissions through <span class="gap">drivectl call drive.v3.permissions.create</span><sup>2</sup>, and parse every result with <span class="gap">-O json or --mcp</span><sup>3</sup>.
    </p>
    <ol class="findings">
      {highlights.map(item => (
        <li>
          <h4>{item.question}</h4>
          <p>{item.detail}</p>
        </li>
      ))}
    </ol>
  </figure>
</section>

<section class="wrap starting-points">
  <div class="explanation">
    <h2>Where to start</h2>
    <p>
      Authenticate once with a Desktop OAuth client secret. <code>drivectl</code> caches and refreshes tokens automatically in <code>~/.config/drivectl/</code>.
    </p>
    <a href={`${base}/guide`}>Read the guide</a>
  </div>
  <nav aria-label="Choose a starting point">
    {startingPoints.map(item => (
      <a href={item.href}>
        <div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
        <Symbol name="arrow_forward" />
      </a>
    ))}
  </nav>
</section>

<section class="wrap install">
  <div class="explanation">
    <h2>Install</h2>
    <p>Choose a prebuilt binary, Go toolchain install, or agent integration.</p>
  </div>
  <fieldset>
    <legend>Choose your installation method</legend>
    {installMethods.map((item, index) => (
      <>
        <input type="radio" name="install-method" id={`install-${index}`} checked={index === 0} />
        <label for={`install-${index}`}>{item.name}</label>
        <div class="panel">
          <p>{item.step}</p>
          <button
            type="button"
            class="copybox focus-ring-outer"
            aria-label={`Copy ${item.name} command: ${item.copy}`}
            data-copy={item.copy}
          >
            <code>{item.copy}</code>
            <span aria-hidden="true">
              <Symbol name="content_copy" class="copy" />
              <Symbol name="check" class="done" />
            </span>
          </button>
        </div>
      </>
    ))}
  </fieldset>
  <p class="limits">
    First-time login requires a Google Cloud Desktop OAuth client secret. <a href={`${base}/install`}>Read the install guide</a> or <a href={repo}>view the source</a>.
  </p>
</section>

<script>
  const timers = new WeakMap<HTMLElement, number>();
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = button.getAttribute('aria-label') ?? '';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      const prev = timers.get(button);
      if (prev) window.clearTimeout(prev);
      button.classList.add('copied');
      button.setAttribute('aria-label', `Copied: ${button.dataset.copy ?? ''}`);
      const timer = window.setTimeout(() => {
        button.classList.remove('copied');
        button.setAttribute('aria-label', label);
      }, 1800);
      timers.set(button, timer);
    });
  }
</script>

<style>
  p { text-wrap: pretty; }
  h1 { font: 500 clamp(2rem, 3vw, 2.5rem) / 1.15 var(--font-display); letter-spacing: -.02em; }
  h2 { font-size: 1.5rem; font-weight: 500; line-height: 1.3; letter-spacing: -.01em; margin-bottom: 16px; text-wrap: balance; }
  h3 { font-size: 1.125rem; font-weight: 500; line-height: 1.4; }
  section + section { border-top: 1px solid var(--md-sys-color-outline-variant); }
  .explanation > p { max-width: 52ch; line-height: 1.7; margin-bottom: 20px; }
  .explanation > a { display: inline-block; margin-top: 4px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 32px; }

  .hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 72px; align-items: start; padding-block: 64px 72px; }
  .lead { max-width: 55ch; margin-top: 20px; line-height: 1.7; text-wrap: pretty; }

  .handoff { margin: 0; }
  .handoff ol { list-style: none; margin: 0; padding: 0; }
  .handoff li { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 20px; padding-bottom: 32px; }
  .handoff li:not(:last-child)::before { content: ''; position: absolute; inset-block: 48px 8px; inset-inline-start: 20px; border-inline-start: 1px solid var(--md-sys-color-outline); }
  .handoff li > :global(svg) { justify-self: center; }
  .node { justify-self: center; width: 9px; height: 9px; margin-top: 14px; border-radius: 50%; background: var(--md-sys-color-outline); }
  .handoff .minor::before { inset-block-start: 32px; }
  .handoff li:last-child { padding-bottom: 0; }
  .handoff h2 { margin: 6px 0 0; font-size: 1.125rem; line-height: 1.4; letter-spacing: 0; }
  .handoff li p { margin-top: 4px; max-width: 36ch; line-height: 1.6; }

  .example { padding-block: 56px 64px; }
  .sheet { margin: 40px 0 0; border: 1px solid var(--md-sys-color-outline-variant); border-radius: 12px; padding: 32px; }
  .sheet > p { margin-top: 16px; max-width: 70ch; font-size: 1.125rem; line-height: 1.9; }
  .gap { text-decoration: underline 2px var(--egm-color-goldfish); text-underline-offset: .3em; color: var(--md-sys-color-on-surface); font-family: var(--font-mono); font-size: 0.92em; }
  .sheet sup { margin-inline-start: 2px; font-size: .6875rem; font-weight: 500; line-height: 1; color: var(--egm-color-goldfish); }
  .findings { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 40px; margin: 28px 0 0; padding: 24px 0 0; border-top: 1px solid var(--md-sys-color-outline-variant); counter-reset: finding; }
  .findings li { counter-increment: finding; }
  .findings li::before { content: counter(finding); display: block; margin-bottom: 6px; font-size: .8125rem; font-weight: 500; line-height: 1.5; color: var(--egm-color-goldfish); }
  .findings h4 { margin: 0; font-size: 1rem; font-weight: 500; line-height: 1.5; }
  .findings p { margin-top: 4px; font-size: .9375rem; line-height: 1.6; }

  .starting-points { display: grid; grid-template-columns: 1fr 1fr; column-gap: 80px; padding-block: 56px 64px; }
  nav > a { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 24px; text-decoration: none; }
  nav > a:first-child { padding-top: 0; }
  nav > a + a { border-top: 1px solid var(--md-sys-color-outline-variant); }
  nav h3 { margin-bottom: 8px; }
  nav p { max-width: 42ch; line-height: 1.6; }
  nav > a:hover h3 { text-decoration: underline; text-underline-offset: .2em; }
  nav :global(svg) { width: 20px; height: 20px; flex: none; color: var(--md-sys-color-on-surface-variant); }

  .install { padding-block: 56px 64px; }
  fieldset { display: flex; flex-wrap: wrap; gap: 4px; max-width: 760px; margin: 32px 0 0; padding: 0; border: 0; }
  legend, fieldset input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  fieldset label { padding: 8px 12px; border-radius: 8px; font-size: .9375rem; font-weight: 500; line-height: 1.5; color: var(--md-sys-color-on-surface-variant); cursor: pointer; }
  fieldset label:hover { color: var(--md-sys-color-on-surface); }
  fieldset input:checked + label { color: var(--md-sys-color-on-secondary-container); background: var(--md-sys-color-secondary-container); }
  fieldset input:focus-visible + label { outline: 3px solid var(--md-sys-color-secondary); outline-offset: 3px; }
  .panel { display: none; order: 1; flex-basis: 100%; margin-top: 20px; }
  fieldset input:checked + label + .panel { display: block; }
  .panel p { margin-bottom: 16px; line-height: 1.6; }
  .copybox { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; width: 100%; padding: 16px; border: 1px solid var(--md-sys-color-outline-variant); border-radius: 8px; background: var(--md-sys-color-surface-container-low); color: var(--md-sys-color-on-surface); text-align: start; cursor: pointer; }
  .copybox:hover { border-color: var(--md-sys-color-outline); }
  .copybox code { font-size: .875rem; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
  .copybox :global(svg) { width: 20px; height: 20px; flex: none; fill: var(--md-sys-color-on-surface-variant); }
  .copybox :global(.done), .copybox:global(.copied) :global(.copy) { display: none; }
  .copybox:global(.copied) :global(.done) { display: block; }
  .limits { margin-top: 28px; font-size: .875rem; line-height: 1.6; color: var(--md-sys-color-on-surface-variant); }

  @media(max-width:900px) { .hero { gap: 40px; } .starting-points { column-gap: 48px; } }
  @media(max-width:760px) {
    .hero, .starting-points { grid-template-columns: 1fr; gap: 40px; }
    .findings { grid-template-columns: 1fr; }
    .hero { padding-block: 48px 56px; }
    .example, .starting-points, .install { padding-block: 48px 56px; }
    .sheet { padding: 24px; }
  }
</style>
