---
import PageActions from './PageActions.astro';
const { entry, toc } = Astro.locals.starlightRoute;
const cmdName = entry.id.startsWith('commands/') ? entry.id.split('/')[1] : undefined;
const badgeLabel =
  cmdName === 'drive' ? 'drivectl list · get · upload' :
  cmdName === 'docs' ? 'drivectl docs' :
  cmdName === 'sheets' ? 'drivectl sheets' :
  cmdName === 'discovery' ? 'drivectl call · run' :
  cmdName === 'mcp' ? 'drivectl --mcp' : undefined;
---
<h1 id="_top">{entry.data.title}</h1>
{entry.data.description && <p class="description">{entry.data.description}</p>}
{badgeLabel && <code>{badgeLabel}</code>}
{!toc && <PageActions placement="standalone" />}
<style>
  h1 { display: flex; align-items: center; gap: 12px; }
  h1 { font-size: var(--sl-text-h1); line-height: 1.2; font-weight: 600; letter-spacing: -.025em; margin: 0; color: var(--sl-color-white); }
  .description { font-size: 1.125rem; line-height: 1.7; color: var(--sl-color-gray-2); margin-top: 20px; max-width: 62ch; }
  code { display: inline-block; font: .875rem / 1.6 var(--sl-font-mono); margin-top: 20px; }
</style>
